APP_NAME="Attendance Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Default connection for tenant databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_tenant
DB_USERNAME=root
DB_PASSWORD=

# Central database for tenant registry and device mapping
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=attendance_central
CENTRAL_DB_USERNAME=root
CENTRAL_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================
# QUEUE CONFIGURATION
# ============================================
QUEUE_CONNECTION=redis
# Queue priorities for attendance processing
QUEUE_HIGH_PRIORITY=attendance-high-priority
QUEUE_DEFAULT=attendance-default
QUEUE_REPORTING=reporting
QUEUE_NOTIFICATIONS=notifications

CACHE_STORE=redis
CACHE_PREFIX=mtan

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# MQTT BROKER CONFIGURATION
# ============================================
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=attendance_monitor
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLEAN_SESSION=true
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_FILE=
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true

# MQTT Topic Configuration
MQTT_TOPIC_RECOGNITION=mqtt/face/+/Rec
MQTT_TOPIC_STRANGER=mqtt/face/+/Stranger
MQTT_TOPIC_DEVICE_STATUS=mqtt/device/+/status
MQTT_QOS=1

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Mail driver: smtp, ses, postmark, mailgun, sendmail, log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production Email Services (uncomment as needed)
# AWS SES Configuration
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=your-ses-key
# AWS_SECRET_ACCESS_KEY=your-ses-secret
# AWS_DEFAULT_REGION=us-east-1

# Postmark Configuration
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=your-postmark-token

# SMTP Configuration (e.g., Gmail, Outlook)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# MULTI-TENANCY CONFIGURATION
# ============================================
# Base domain for tenant subdomains (e.g., tenant.attendance.com)
TENANT_BASE_DOMAIN=attendance.local
# Cache TTL for tenant resolution (in minutes)
TENANT_CACHE_TTL=5
# Tenant database prefix
TENANT_DB_PREFIX=tenant_

# ============================================
# SUPER ADMIN CONFIGURATION
# ============================================
# Super admin credentials for initial setup
SUPER_ADMIN_EMAIL=admin@system.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="System Administrator"

# ============================================
# ATTENDANCE SYSTEM CONFIGURATION
# ============================================
# Duplicate detection window (in minutes)
ATTENDANCE_DUPLICATE_WINDOW=1
# Default recognition threshold (0-100)
ATTENDANCE_MIN_RECOGNITION_SCORE=85
# Live feed refresh interval (in seconds)
ATTENDANCE_LIVE_FEED_REFRESH=5
# Maximum records per page
ATTENDANCE_RECORDS_PER_PAGE=50

# ============================================
# DEVICE SYNC CONFIGURATION
# ============================================
# Device heartbeat timeout (in minutes)
DEVICE_HEARTBEAT_TIMEOUT=5
# Device sync retry attempts
DEVICE_SYNC_MAX_RETRIES=3
# Device capacity warning threshold (percentage)
DEVICE_CAPACITY_WARNING=80
